<?xml version="1.0"?>
<formdef id="10" url="https://wcs.dev.publik.love/backoffice/forms/10/">
  <name>Plaines de vacances</name>
  <url_name>pp-plaines-de-vacances</url_name>
  <keywords>Plaines de vacances, inscriptions</keywords>
  <drafts_lifespan>2</drafts_lifespan>
  <submission_user_association>any</submission_user_association>
  <history_pane_default_mode>expanded</history_pane_default_mode>
  <discussion>false</discussion>
  <detailed_emails>true</detailed_emails>
  <disabled>false</disabled>
  <only_allow_one>false</only_allow_one>
  <enable_tracking_codes>true</enable_tracking_codes>
  <confirmation>false</confirmation>
  <always_advertise>false</always_advertise>
  <has_captcha>false</has_captcha>
  <skip_from_360_view>false</skip_from_360_view>
  <category slug="portail-parent" category_id="5">Portail Parents</category>
  <workflow slug="portail-parent-plaines-de-vacances" workflow_id="10">Portail Parent - Plaines de vacances</workflow>
  <fields>
    <field>
      <type>page</type>
      <label type="str">Inscription</label>
      <post_conditions>
        <post_condition>
          <condition>
            <type>django</type>
            <value>form_var_acces_autorise</value>
          </condition>
          <error_message>Les conditions d'inscription ne sont pas remplies. Si votre situation vient d'&#234;tre corrig&#233;e, cliquez &#224; nouveau sur le bouton de validation.</error_message>
        </post_condition>
        <post_condition>
          <condition>
            <type>django</type>
            <value>not form_var_acces_autorise or form_var_activities_plaines</value>
          </condition>
          <error_message>Aucune plaine n'a &#233;t&#233; choisie.</error_message>
        </post_condition>
      </post_conditions>
      <id type="str">64</id>
    </field>
    <field>
      <type>computed</type>
      <label type="str">Identifiant de l'enfant</label>
      <varname type="str">id_enfant</varname>
      <value_template type="str">{{request.GET.enfant|default:""}}</value_template>
      <freeze_on_initial_value type="bool">True</freeze_on_initial_value>
      <id type="str">61</id>
    </field>
    <field>
      <type>computed</type>
      <label type="str">Implantation scolaire</label>
      <varname type="str">implantation_scolaire</varname>
      <value_template type="str">{% for child in data_source.portail_parent_enfants %}{% if child.id|stringformat:"s" == form_var_id_enfant %}{{ child.school_implantation|get:0|stringformat:"s" }}{% endif %}{% endfor %}</value_template>
      <freeze_on_initial_value type="bool">True</freeze_on_initial_value>
      <id type="str">05b61824-5bea-430a-946c-07b396bb74f4</id>
    </field>
    <field>
      <type>computed</type>
      <label type="str">Acc&#232;s autoris&#233;</label>
      <varname type="str">acces_autorise</varname>
      <value_template type="str">{% if not "Habitant dans la commune" in form_option_priorites and not "Enfants scolaris&#233;s dans la commune" in form_option_priorites or not "Habitant dans la commune" in form_option_priorites and not form_option_implantations_scolaires_raw or "Habitant dans la commune" in form_option_priorites and not "Enfants scolaris&#233;s dans la commune" in form_option_priorites and form_user_var_zipcode in commune_cp or "Habitant dans la commune" in form_option_priorites and not form_option_implantations_scolaires_raw and form_user_var_zipcode in commune_cp or not "Habitant dans la commune" in form_option_priorites and "Enfants scolaris&#233;s dans la commune" in form_option_priorites and form_option_implantations_scolaires_raw and form_var_implantation_scolaire in form_option_implantations_scolaires_raw or "Habitant dans la commune" in form_option_priorites and "Enfants scolaris&#233;s dans la commune" in form_option_priorites and form_option_implantations_scolaires_raw and form_user_var_zipcode in commune_cp or "Habitant dans la commune" in form_option_priorites and "Enfants scolaris&#233;s dans la commune" in form_option_priorites and form_option_implantations_scolaires_raw and form_var_implantation_scolaire in form_option_implantations_scolaires_raw %}1{% endif %}</value_template>
      <freeze_on_initial_value type="bool">False</freeze_on_initial_value>
      <id type="str">03bb74ec-d43c-4861-933d-5529430620dc</id>
    </field>
    <field>
      <type>item</type>
      <label type="str">Choisissez l'enfant &#224; inscrire aux plaines</label>
      <required type="str">optional</required>
      <varname type="str">enfant</varname>
      <display_locations>
        <item>validation</item>
        <item>summary</item>
        <item>listings</item>
      </display_locations>
      <extra_css_class type="str">hidden</extra_css_class>
      <prefill>
        <locked>True</locked>
        <type>string</type>
        <value>{{ form_var_id_enfant }}</value>
      </prefill>
      <anonymise type="str">no</anonymise>
      <display_mode type="str">radio</display_mode>
      <items />
      <data_source>
        <type>portail_parent_enfants</type>
        <value>{{ passerelle_url }}passerelle-imio-ia-aes/aes/parents/{{ form_user_var_aes_id }}/children/</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <use_hint_as_first_option type="bool">True</use_hint_as_first_option>
      <image_desktop_size type="int">150</image_desktop_size>
      <image_mobile_size type="int">75</image_mobile_size>
      <id type="str">22</id>
    </field>
    <field>
      <type>comment</type>
      <label type="str">&lt;p&gt;Vous inscrivez &lt;span class="varname"&gt;{{ form_var_enfant }}&lt;/span&gt; aux plaines de vacances.&lt;/p&gt;
</label>
      <condition>
        <type>django</type>
        <value>form_var_enfant and form_var_acces_autorise</value>
      </condition>
      <extra_css_class type="str">pk-information</extra_css_class>
      <display_locations />
      <id type="str">55</id>
    </field>
    <field>
      <type>comment</type>
      <label type="str">&lt;p&gt;{{ form_option_message_aux_non_prioritaires|default:"Veuillez attendre l'ouverture des plaines &#224; tous" }}&lt;/p&gt;
&lt;p&gt;Les inscriptions sont actuellement r&#233;serv&#233;es :&lt;/p&gt;
&lt;ul&gt;
{% if "Habitant dans la commune" in form_option_priorites %}&lt;li&gt;aux habitants de la commune&lt;/li&gt;{% endif %}
{% if "Enfants scolaris&#233;s dans la commune" in form_option_priorites and form_option_implantations_scolaires_raw %}&lt;li&gt;aux enfants scolaris&#233;s dans : {% for i in form_option_implantations_scolaires_structured %}{{ i.text }}{% if not forloop.last %}, {% endif %}{% endfor %}&lt;/li&gt;{% endif %}
&lt;/ul&gt;
</label>
      <condition>
        <type>django</type>
        <value>not form_var_acces_autorise</value>
      </condition>
      <extra_css_class type="str">pk-attention</extra_css_class>
      <display_locations />
      <id type="str">66</id>
    </field>
    <field>
      <type>items</type>
      <label type="str">Plaines</label>
      <condition>
        <type>django</type>
        <value>form_var_acces_autorise</value>
      </condition>
      <required type="str">required</required>
      <hint type="str">Choisissez vos plaines</hint>
      <varname type="str">activities_plaines</varname>
      <display_locations>
        <item>validation</item>
      </display_locations>
      <extra_css_class type="str">hidden</extra_css_class>
      <anonymise type="str">final</anonymise>
      <items />
      <display_mode type="str">checkboxes</display_mode>
      <min_choices type="int">0</min_choices>
      <max_choices type="int">0</max_choices>
      <data_source>
        <type>jsonvalue</type>
        <value>[{% for week in webservice.aes_get_available_plaines %}{% for activity in week|get:"activities" %}{{ activity|json_dumps }}{% if not forloop.last %}, {% endif %}{% endfor %}{% if not forloop.last %}, {% endif %}{% endfor %}]</value>
      </data_source>
      <in_filters type="bool">False</in_filters>
      <display_disabled_items type="bool">False</display_disabled_items>
      <image_desktop_size type="int">150</image_desktop_size>
      <image_mobile_size type="int">75</image_mobile_size>
      <id type="str">53</id>
    </field>
    <field>
      <type>comment</type>
      <label type="str">&lt;p&gt;Plaines&lt;/p&gt;
</label>
      <condition>
        <type>django</type>
        <value>form_var_acces_autorise</value>
      </condition>
      <extra_css_class type="str">template-portail_parent_plaines</extra_css_class>
      <display_locations />
      <id type="str">54</id>
    </field>
    <field>
      <type>comment</type>
      <label type="str">&lt;h2&gt;&lt;img alt="" src="https://nivelles.guichet-citoyen.be/media/uploads/2024/05/03/bus.png" style="width: 40px; height: 40px;"&gt;&amp;nbsp;R&amp;eacute;servation des navettes&lt;/h2&gt;
</label>
      <condition>
        <type>django</type>
        <value>pp_redirection_navette and form_var_acces_autorise</value>
      </condition>
      <display_locations />
      <id type="str">24474e7a-b5c3-40fe-bbdb-9fa9e303dc7f</id>
    </field>
    <field>
      <type>bool</type>
      <label type="str">R&#233;server des navettes pour cet enfant et ces plaines</label>
      <condition>
        <type>django</type>
        <value>pp_redirection_navette and form_var_acces_autorise</value>
      </condition>
      <required type="str">optional</required>
      <hint type="str">Vous serez redirig&#233;s vers un formulaire pour la r&#233;servation de navette.</hint>
      <varname type="str">redirection_navette</varname>
      <display_locations />
      <anonymise type="str">no</anonymise>
      <id type="str">66a76ec5-9a4a-467a-92ed-f5c8232d9a95</id>
    </field>
  </fields>
  <user-roles>
    <role role_id="logged-users">logged-users</role>
  </user-roles>
  <roles>
    <role slug="debug" role_id="18e7ab5ef71146f0a584588e61393986" role_key="_debug">Debug</role>
    <role slug="agent-traitant-portail-parents-plaines" role_id="dd1d6a0d74404a8a94fd27ba590f5b2d" role_key="_receiver">Agent traitant - Portail Parents - Plaines</role>
    <role slug="agent-imio-portail-parents" role_id="17ebb1be538243ae90fd1f40f240c120" role_key="_support-imio">Agent iMio - Portail Parents</role>
  </roles>
  <options>
    <option varname="message_aux_non_residents">/</option>
    <option varname="mode_de_paiement">Paiement en ligne</option>
    <option varname="mode_de_paiement_display">Paiement en ligne</option>
    <option varname="mode_de_paiement_structured" />
    <option varname="ouvertes_aux_habitants">Ouvrir les plaines &#224; tous</option>
    <option varname="ouvertes_aux_habitants_display">Ouvrir les plaines &#224; tous</option>
    <option varname="ouvertes_aux_habitants_structured" />
  </options>
  <custom_views />
  <geolocations />
  <management_sidebar_items>
    <item>__default__</item>
  </management_sidebar_items>
  <submission_sidebar_items>
    <item>__default__</item>
  </submission_sidebar_items>
</formdef>